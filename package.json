{
  "name": "asean-watch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-api.mjs && vite build",
    "build:api": "node scripts/build-api.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:region": "node scripts/build-region.mjs",
    "refresh:data": "node scripts/refresh-data.mjs",
    "refresh:warnings": "node scripts/capture-warnings-snapshot.mjs",
    "refresh:nea": "node scripts/capture-nea-snapshot.mjs",
    "refresh:all": "npm run refresh:data && npm run refresh:warnings && npm run refresh:nea && npm run refresh:wind && npm run refresh:wind925 && npm run refresh:aq && npm run refresh:fires",
    "refresh:fires": "node scripts/refresh-fires.mjs",
    "build:fire-admin": "node scripts/build-fire-admin.mjs",
    "refresh:wind": "node scripts/capture-wind-snapshot.mjs",
    "refresh:aq": "node scripts/capture-aq-snapshot.mjs",
    "refresh:wind925": "node scripts/capture-wind-snapshot.mjs 925hPa",
    "refresh:ashwind": "node scripts/capture-ash-wind-snapshot.mjs",
    "build:idn-centroids": "node scripts/build-idn-centroids.mjs",
    "refresh:quakes": "node scripts/capture-quakes-snapshot.mjs",
    "refresh:sealevel": "node scripts/capture-sealevel-snapshot.mjs",
    "refresh:ptwc": "node scripts/capture-ptwc-snapshot.mjs",
    "refresh:flood": "node scripts/capture-flood-snapshot.mjs",
    "check:gibs": "node scripts/capture-gibs-check.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^6.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
